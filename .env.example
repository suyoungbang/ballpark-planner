# 이 파일을 복사해 같은 폴더에 .env로 저장한 뒤 값을 고친다. (.env는 Git에 올라가지 않는다)
# OPENAI_API_KEY는 Windows 사용자 환경 변수로 등록하는 것을 권한다. 여기에 적어도 동작은 한다.
# 키가 없으면 서버가 시작할 때 AI 그래프를 만들지 못해 실행되지 않는다.

# 1. OpenAI Platform 관련 설정
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_TIMEOUT_SECONDS=30

# 2. LangSmith 추적 설정 (선택) - 추적하려면 true로 바꾸고 Personal Access Token을 넣는다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ballpark-planner-langchain
